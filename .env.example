PORT=5000
MONGO_URI=mongodb+srv://<user>:<pass>@cluster0.mongodb.net/caly-ai
MONGO_DB=caly-ai
JWT_SECRET=change-me-to-a-long-random-string
# Vision AI - Groq recommended (free tier, fast): key starts with gsk_
# Defaults to qwen/qwen3.8-27b (Groq vision model); set VISION_MODEL to override.
GROQ_API_KEY=
# GROQ_BASE_URL= only if you proxy Groq's OpenAI-compatible API
# GROQ_BASE_URL=
VISION_MODEL=qwen/qwen3.8-27b
# Or use OpenAI instead: set OPENAI_API_KEY (sk-...) and leave GROQ_API_KEY empty.
# OPENAI_API_KEY=sk-...

# Food catalog import (one-off: node scripts/import-fdc.js) — NOT read by the
# running server, which serves the catalog from the local DB.
# Get a key in ~30s: https://api.data.gov/signup/ (1,000 req/hr)
FDC_API_KEY=

# Food catalog images (Cloudinary — all three required)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

NODE_ENV=development
# Behind one hosting proxy (Render/Railway/Fly) this MUST be on or all
# phones share one rate-limit bucket. Empty/unset: production defaults to 1,
# dev to off. Set 0 only for a directly-exposed server.
TRUST_PROXY=
# Empty = permissive default (same as unset). Set explicit origins in prod.
CORS_ORIGINS=
# Per-IP per 15 min. Defaults: API 600 (mobile CGNAT shares IPs), auth 50.
API_LIMIT=600
# Credential endpoints only (register/login/verify/resend/skip/forgot/reset).
AUTH_LIMIT=50
# Per-user paid-vision scans per UTC day (cost guard on the shared provider quota).
SCAN_DAILY_LIMIT=50
# Where /api/support forwards user messages (defaults to support@caly-ai.app).
SUPPORT_EMAIL=

# Email (SMTP) — verification & password reset codes. Without SMTP_HOST,
# emails are logged to the console instead of sent.
# CALY_TEST_INBOX=1 captures sent emails in memory for tests instead of sending.
#
# Hosted on Render FREE? Its firewall blocks outbound ports 25/465/587, so
# Gmail SMTP (smtp.gmail.com:587) can't connect — use a relay on a port it
# allows. Resend example (verify your domain first, then paste the re_... key):
#   SMTP_HOST=smtp.resend.com
#   SMTP_PORT=2587        # STARTTLS (2465 = implicit TLS, then SMTP_SECURE=1)
#   SMTP_SECURE=false
#   SMTP_USER=resend
#   SMTP_PASS=re_xxxxxxxxx
#   SMTP_FROM=Caly AI <no-reply@yourdomain.com>
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Caly AI <no-reply@caly-ai.app>


